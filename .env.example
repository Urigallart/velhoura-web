# Copy this file to .env.local for local development.
# Get a free API key at https://resend.com — needed for the contact modal
# (POST /api/contact) to actually send email. Also add it in Vercel under
# Project Settings -> Environment Variables for it to work in production.
RESEND_API_KEY=

# Stripe secret key for the client payments page (/gestiones, /api/pay/*).
# Dashboard -> Developers -> API keys. Use sk_test_... while testing, then
# sk_live_... Also add it in Vercel (Production) and redeploy.
STRIPE_SECRET_KEY=
